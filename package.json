{
  "name": "dsh-work-pay-note",
  "version": "1.0.0",
  "description": "A draggable sticky note in DeepSeek Harness that counts today's and this month's earnings in real time from your work hours.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "sticky-note",
    "earnings",
    "widget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meijieYUan/dsh-work-pay-note.git"
  },
  "homepage": "https://github.com/meijieYUan/dsh-work-pay-note#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
